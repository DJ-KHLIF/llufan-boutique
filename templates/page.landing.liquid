{%- layout none -%}
{%- comment -%}
  Landing Llufan : page autonome sur llufan.com (design figé : landing/App.design-freeze.tsx).
  Sources React : landing/. Après toute modification : cd landing && npm run build:shopify (régénère assets/llufan-landing*).
  Mise en ligne : Boutique en ligne > Pages > une page > Modèle « landing ». Aperçu sans rien changer : /pages/<page>?view=landing
  Même domaine que la boutique : le service de commande (llufan-cod-order) accepte les commandes du formulaire.
  Prix et disponibilités : lus ici dans Shopify, puis transmis à la page (llufan-landing-data).
{%- endcomment -%}
{%- liquid
  assign keys = 'nomad,poncho,housse,ensemble' | split: ','
  assign handles = 'coussin-confort-v-nomade-compact,poncho-coton-llufan,housse-de-rechange-nomad-llufan,llufan-ensemble-nomad-coussin-poncho' | split: ','
  assign descriptions = 'Coussin en forme de V, 59 cm, housse 100% coton. Coloris bleu papillons, rose papillons ou gris.|Poncho en coton, 75 × 60 cm à plat. Coloris bleu, rose ou gris.|Housse de rechange pour le coussin Nomad.|Coussin Nomad, poncho et housse de rechange offerte.' | split: '|'
  assign meta_title = 'Coussin de maternité Nomad compact 59 cm, coton – Llufan'
  assign meta_description = 'Coussin de maternité Nomad en forme de V, compact, housse 100% coton lavable. Bleu, rose ou gris. Paiement à la livraison, 58 wilayas. Atelier Algérie.'
  assign hero = all_products['coussin-confort-v-nomade-compact']
-%}
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#FFF8F0">
<title>{{ meta_title }}</title>
<meta name="description" content="{{ meta_description | escape }}">
<link rel="canonical" href="{{ canonical_url }}">
{% if settings.favicon %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">{% endif %}
<meta property="og:type" content="website">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ meta_title | escape }}">
<meta property="og:description" content="{{ meta_description | escape }}">
{% if hero.featured_image %}<meta property="og:image" content="https:{{ hero.featured_image | image_url: width: 1200 }}">{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
{{ 'llufan-landing.css' | asset_url | stylesheet_tag }}
{{ content_for_header }}
{% render 'meta-ids' %}
<script type="application/ld+json">
{"@context":"https://schema.org","@graph":[
{%- assign sep = '' -%}
{%- for h in handles -%}
  {%- assign p = all_products[h] -%}
  {%- if p.id -%}
  {{ sep }}{"@type":"Product","name":{{ p.title | json }},"brand":{"@type":"Brand","name":"Llufan"},"description":{{ descriptions[forloop.index0] | json }},
  {%- if p.featured_image -%}"image":{{ p.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},{%- endif -%}
  "offers":{"@type":"Offer","url":{{ p.url | prepend: request.origin | json }},"priceCurrency":{{ shop.currency | json }},"price":{{ p.price | divided_by: 100 | json }},"availability":"https://schema.org/{% if p.available %}InStock{% else %}OutOfStock{% endif %}"}}
  {%- assign sep = ',' -%}
  {%- endif -%}
{%- endfor -%}
{{ sep }}{"@type":"FAQPage","mainEntity":[
{"@type":"Question","name":"Est-ce lavable en machine ?","acceptedAnswer":{"@type":"Answer","text":"Oui, la housse est en 100% coton. Vérifiez l'étiquette d'entretien de votre pièce avant lavage."}},
{"@type":"Question","name":"Quelle est la différence avec un coussin normal ?","acceptedAnswer":{"@type":"Answer","text":"Le Nomad a une forme boomerang compacte, pensée pour allaiter partout et se transporter facilement."}},
{"@type":"Question","name":"Taille unique ? Ça convient à quelle taille ?","acceptedAnswer":{"@type":"Answer","text":"Le Nomad est en taille unique. Pour toute question sur les dimensions, écrivez-nous sur WhatsApp."}}]}
]}
</script>
<script type="application/json" id="llufan-landing-data">{"products":{
{%- assign sep = '' -%}
{%- for h in handles -%}
  {%- assign p = all_products[h] -%}
  {%- if p.id -%}
  {{ sep }}{{ keys[forloop.index0] | json }}:{"price":{{ p.price | divided_by: 100 | json }},"variants":[
    {%- for v in p.variants -%}{"id":{{ v.id | append: '' | json }},"available":{{ v.available | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}
  {%- assign sep = ',' -%}
  {%- endif -%}
{%- endfor -%}
}}</script>
</head>
<body>
<div id="root"></div>
<noscript>
  <div style="max-width:560px;margin:40px auto;padding:0 18px;font-family:Inter,system-ui,sans-serif;color:#2B1A11;text-align:center">
    <p style="font-weight:700;font-size:18px">Llufan — Coussin Nomad</p>
    <p>Pour commander, activez JavaScript ou écrivez-nous sur WhatsApp au +213 549 80 09 60.</p>
    <p><a href="{{ routes.root_url }}" style="color:#7A4A2E">Voir la boutique</a></p>
  </div>
</noscript>
<script type="module" src="{{ 'llufan-landing.js' | asset_url }}"></script>
</body>
</html>
